# Local development only. Never put provider keys in VITE_* variables.
DEPLOYMENT_MODE=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:5173
# For authenticated self-host: DEPLOYMENT_MODE=private, configure these.
# Use HTTPS except for an explicitly local loopback APP_ORIGIN.
# DATABASE_URL=
# TEST_DATABASE_URL=
# BOOTSTRAP_TOKEN=
# BOOTSTRAP_TOKEN must be a randomly generated secret of at least 32 characters.
# Optional: 32 random bytes encoded as base64, from an external secret store.
# VAULT_MASTER_KEY=
# VAULT_MASTER_KEY_ID=master-1
# Public OIDC integration is still in progress and currently fails closed.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
